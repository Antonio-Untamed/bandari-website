    "pg-cloudflare": "^1.4.1",
    "postgres": "^4.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "wrangler": "^4.86.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
